# Signing server settings for scripts/release.sh. Copy to scripts/release.env (ignored by git) and fill in.
# The server signs macOS binaries with rcodesign; the private key never leaves it.
# Binaries are passed through an S3 bucket that both this machine and the server can read and write,
# the signing runs through AWS SSM (AWS-RunShellScript) as root.

SIGN_INSTANCE=i-0123456789abcdef0             # EC2 instance ID of the signing server
SIGN_REGION=us-east-1                         # its AWS region
SIGN_BUCKET=my-signing-bucket                 # S3 bucket for the temporary transfer (files are deleted after)

# paths on the signing server
SIGN_KEY=/path/to/developer-id-application.key
SIGN_CERT=/path/to/developer-id-application.pem
SIGN_CHAIN=/path/to/apple-developer-id-g2-ca.pem   # Apple Developer ID G2 intermediate certificate
SIGN_RCODESIGN=/usr/local/bin/rcodesign

BUNDLE_ID=com.example.go2rtc                  # code signing identifier
TEAM_ID=ABCDE12345                            # Apple team ID (checked in the signed result)
